include LICENSE
include README.rst
include Dockerfile
include requirements.txt

# needs to be installed in site-packages
recursive-include radiopadre/notebooks *.ipynb
recursive-include radiopadre/html *.js *.css *.ico *.png
recursive-include radiopadre_kernel/js9 *.html

# needs to be in tarball, copied over by setup script
recursive-include radiopadre/js9-config *.js *.json
recursive-include radiopadre/icons *.svg *.ico *.png
